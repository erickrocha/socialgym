# Copy this file to `.env` and fill in every CHANGE_ME value before running
# `docker compose -f billion/compose.yml up`. Never commit the real `.env`.

# --- Timeline service ---
TIMELINE_HOST=0.0.0.0
TIMELINE_PORT=8091
TIMELINE_DATABASE_NAME=timeline
# App user (MONGODB_USERNAME/MONGODB_PASSWORD), NOT root. The path db, authSource,
# TIMELINE_DATABASE_NAME and compose's MONGODB_DATABASE must all be the same name.
TIMELINE_DATABASE_URL=mongodb://timeline:CHANGE_ME@mongo:27017/timeline?authSource=timeline
TIMELINE_AWS_WORKOUT_BUCKET=CHANGE_ME
TIMELINE_AWS_REGION=us-east-1
TIMELINE_CLOUDFRONT_KEY_PAIR_ID=CHANGE_ME
TIMELINE_CLOUDFRONT_DOMAIN=CHANGE_ME
# AWS IAM credentials - rotate/obtain via the AWS console, not generated locally
TIMELINE_AWS_ACCESS_KEY_ID=CHANGE_ME
TIMELINE_AWS_SECRET_ACCESS_KEY=CHANGE_ME
# JWT secrets are shared across all three Rust services - see AUTH_*_TOKEN_SECRET below.
# CloudFront signed-URL private key (PEM, \n-escaped) - from the AWS console
TIMELINE_PRIVATE_KEY_RAW=CHANGE_ME

# --- Workout service ---
WORKOUT_HOST=0.0.0.0
WORKOUT_PORT=8090
WORKOUT_DATABASE_NAME=workout
WORKOUT_RUST_LOG=info
# postgresql://workout:<POSTGRES_PASSWORD below>@postgres:5432/workout
WORKOUT_DATABASE_URL=postgresql://workout:CHANGE_ME@postgres:5432/workout
WORKOUT_AWS_WORKOUT_BUCKET=CHANGE_ME
WORKOUT_AWS_SQS_QUEUE_URL=CHANGE_ME
WORKOUT_AWS_REGION=us-east-1
WORKOUT_CLOUDFRONT_KEY_PAIR_ID=CHANGE_ME
WORKOUT_CLOUDFRONT_DOMAIN=CHANGE_ME
# AWS IAM credentials - rotate/obtain via the AWS console, not generated locally
WORKOUT_AWS_ACCESS_KEY_ID=CHANGE_ME
WORKOUT_AWS_SECRET_ACCESS_KEY=CHANGE_ME
# JWT secrets are shared across all three Rust services - see AUTH_*_TOKEN_SECRET below.
# CloudFront signed-URL private key (PEM, \n-escaped) - from the AWS console
WORKOUT_PRIVATE_KEY_RAW=CHANGE_ME

# Version identifiers must match the reviewed content published by the API.
TERMS_VERSION=1.0.0
PRIVACY_VERSION=1.0.0
HEALTH_DATA_CONSENT_VERSION=1.0.0

# Shared service credential for export and account-purge coordination.
INTERNAL_SERVICE_SECRET=CHANGE_ME
TIMELINE_BASE_URL=http://timeline-app:8091
ACCOUNT_DELETION_GRACE_DAYS=30
ACCOUNT_PURGE_INTERVAL_SECONDS=900

# --- Shared JWT secrets ---
# workout-app, integration-app and timeline-app must ALL use the identical value
# here. If they differ, a token minted by /login (workout-app) fails HS512
# validation in timeline-app / integration-app and requests return 401.
# Generate with: openssl rand -base64 96 | tr -d '\n'
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME
AUTH_REFRESH_TOKEN_SECRET=CHANGE_ME

# --- Integration (gRPC) service ---
INTEGRATION_HOST=0.0.0.0
INTEGRATION_TLS_CERT_PATH=/etc/grpc/certs/server.crt
INTEGRATION_TLS_KEY_PATH=/etc/grpc/certs/server.key
GRPC_PROTOCOL=https
GRPC_HOST=integration-app
GRPC_DOMAIN_NAME=integration-app
GRPC_PORT=50051
GRPC_USE_TLS=true
GRPC_CERT_PATH=/etc/grpc/certs/server.crt

# --- Database credentials (used by billion/compose.yml postgres & mongo services) ---
# Generate with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
POSTGRES_USER=workout
POSTGRES_PASSWORD=CHANGE_ME
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGODB_USERNAME=timeline
MONGODB_PASSWORD=CHANGE_ME
