HOST=
PORT=
DATABASE_NAME=
RUST_LOG=
# Local Compose: postgresql://workout:<POSTGRES_PASSWORD>@localhost:5432/workout
DATABASE_URL=
AWS_WORKOUT_BUCKET=
AWS_SQS_QUEUE_URL=
AWS_REGION=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TERMS_VERSION=1.0.0
PRIVACY_VERSION=1.0.0
HEALTH_DATA_CONSENT_VERSION=1.0.0
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
PRIVATE_KEY_RAW=

# Address search endpoint (GET /workout/api/address/search), backed by
# Google Places API (New). Disabled by default — set to "true" to enable.
# GOOGLE_MAPS_API_KEY is only required once this is enabled; enable
# "Places API (New)" for that key in Google Cloud Console.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Account deletion (App Store / Play Store requirement): grace period for the
# non-immediate delete-account path, and how often the background sweep checks
# for accounts whose grace period (or immediate request) has elapsed.
ACCOUNT_DELETION_GRACE_DAYS=30
ACCOUNT_PURGE_INTERVAL_SECONDS=900

# Internal service-to-service call to `timeline` to cascade-delete a person's
# posts/comments/reactions/evolution-check-ins as part of account deletion.
# INTERNAL_SERVICE_SECRET must be set to the SAME value in timeline's .env.
TIMELINE_BASE_URL=
INTERNAL_SERVICE_SECRET=

INTEGRATION_HOST=
TLS_CERT_PATH=../infra/certs/server.crt
TLS_KEY_PATH=../infra/certs/server.key
GRPC_PROTOCOL=
GRPC_HOST=
GRPC_DOMAIN_NAME=
GRPC_PORT=
GRPC_USE_TLS=
GRPC_CERT_PATH=

# ---- Auth hardening (password policy / login lockout / token revocation) ----
# Master dev on/off switch: set to "false" to disable password policy, login
# lockout and token-revocation checks all at once for local development.
# Each of the *_ENABLED vars below overrides this master switch when set.
AUTH_RULES_ENABLED=true

PASSWORD_POLICY_ENABLED=
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

LOGIN_LOCKOUT_ENABLED=
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_LOCKOUT_DURATION_SECONDS=900

TOKEN_REVOCATION_ENABLED=

# Comma-separated list of origins allowed to call this API's browser-facing
# routes (e.g. https://app.example.com). Falls back to localhost dev origins
# when unset — set explicitly in production.
CORS_ALLOWED_ORIGINS=

# Postgres connection pool (workout/application and workout/integration each
# open their own pool against the same instance — size accordingly).
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_CONNECT_TIMEOUT_SECS=8
DB_POOL_ACQUIRE_TIMEOUT_SECS=8
DB_POOL_IDLE_TIMEOUT_SECS=300
