HOST=
PORT=
DATABASE_NAME=
RUST_LOG=
# Local Compose: postgresql://workout:<POSTGRES_PASSWORD>@localhost:5432/workout
DATABASE_URL=
AWS_WORKOUT_BUCKET=
AWS_SQS_QUEUE_URL=
AWS_REGION=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
PRIVATE_KEY_RAW=

INTEGRATION_HOST=
TLS_CERT_PATH=../infra/certs/server.crt
TLS_KEY_PATH=../infra/certs/server.key
GRPC_PROTOCOL=
GRPC_HOST=
GRPC_DOMAIN_NAME=
GRPC_PORT=
GRPC_USE_TLS=
GRPC_CERT_PATH=

# ---- Auth hardening (password policy / login lockout / token revocation) ----
# Master dev on/off switch: set to "false" to disable password policy, login
# lockout and token-revocation checks all at once for local development.
# Each of the *_ENABLED vars below overrides this master switch when set.
AUTH_RULES_ENABLED=true

PASSWORD_POLICY_ENABLED=
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

LOGIN_LOCKOUT_ENABLED=
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_LOCKOUT_DURATION_SECONDS=900

TOKEN_REVOCATION_ENABLED=
